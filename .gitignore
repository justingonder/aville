.env
__pycache__/
*.pyc
.venv/
venv/
data/app.db-journal
# OG images are build artifacts — per-event OGs (images/og/) are regenerated
# when missing and the homepage OG (images/og-home.jpg) is regenerated every
# build. All other images (business flyers) ARE committed so a fresh checkout
# can build the site without running extraction, and so historical flyers
# persist even when a source page stops advertising the event.
public/images/og/
public/images/og-home.jpg
public/index.html
public/index.md
public/llms.txt
public/business/
public/event/
public/robots.txt
public/sitemap.xml
public/*.css
.DS_Store
*.log

# Local Claude Code permission state — per-machine, contains absolute paths
# from whatever machine wrote it. .claude/settings.json is the shared config
# and stays tracked.
.claude/settings.local.json

# Local design brainstorm canvases (Claude Design output written to disk
# during a brainstorm session). Not part of the build.
.superpowers/

# Local DB query scratchpad — DBeaver notes, not a project resource.
docs/dbeaver-queries.sql

# Design canvases / handoff bundles from Claude Design — useful as references
# while iterating but not part of the build. Kept locally, not in the repo.
design/

# Local pre-trim backup of CLAUDE.md (kept on disk only; git history is the
# real source of truth for prior versions).
CLAUDE.md.backup
