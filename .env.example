# Anthropic API key for extraction
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for extraction. Haiku is plenty for this task and ~10x cheaper than Sonnet.
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Optional: where to upload the static site (for deploy script).
# Leave blank to skip deploy step.
NAMECHEAP_SSH_HOST=
NAMECHEAP_SSH_USER=
NAMECHEAP_SSH_PATH=/home/USER/public_html/andersonville/
