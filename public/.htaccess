<IfModule mod_headers.c>

  # Hash-versioned CSS (e.g. index.99879a70.css) — content changes when hash changes
  <FilesMatch "\.[a-f0-9]{8}\.css$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # Content-addressed WebP images — SHA-256 hex filename, with optional -400w/-800w suffix
  <FilesMatch "^[a-f0-9]{16}(-[0-9]+w)?\.webp$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # OG images (event ID or og-home.jpg), app icons, manifest — 7 days
  <FilesMatch "^(og-home|[0-9]+)\.jpg$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(ico|svg|png|webmanifest)$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>

  # HTML pages — short browser cache, longer edge cache.
  # Daily rebuild workflow purges Cloudflare on every deploy, so a 1h
  # edge TTL is safe (worst case: 1h of stale HTML if purge ever fails).
  # 5min browser cache means returning visitors within the window get
  # an instant page from local cache.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, s-maxage=3600"
  </FilesMatch>

</IfModule>
