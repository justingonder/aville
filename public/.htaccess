<IfModule mod_headers.c>

  # Hash-versioned CSS (e.g. index.99879a70.css) — content changes when hash changes
  <FilesMatch "\.[a-f0-9]{8}\.css$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # Content-addressed WebP images — SHA-256 hex filename, with optional -400w/-800w suffix
  <FilesMatch "^[a-f0-9]{16}(-[0-9]+w)?\.webp$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # OG images (event ID or og-home.jpg), app icons, manifest — 7 days
  <FilesMatch "^(og-home|[0-9]+)\.jpg$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(ico|svg|png|webmanifest)$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>

  # HTML pages — always revalidate.
  # HTML is the "pointer" that references content-hashed CSS/JS/images (all
  # immutable above), so it must never be served stale: a deploy changes the
  # hashes the HTML points at. `no-cache` lets browsers AND the Cloudflare edge
  # keep a copy but forces a freshness check (cheap 304 via ETag/Last-Modified)
  # on every request, so deploys are visible immediately — no waiting on a
  # browser/edge TTL or relying on the purge firing perfectly. The deploy still
  # purges Cloudflare as a backstop. Trade-off: a revalidation round-trip per
  # HTML view (negligible at this scale; assets stay fully cached/immutable).
  #
  # Link headers (RFC 8288) advertise resources for AI agents & crawlers:
  #   - sitemap: the XML sitemap
  #   - describedby: the /llms.txt agent orientation page
  #   - alternate (text/markdown): the markdown sibling of this page.
  #     The relative URI-ref <index.md> resolves per-request, so it
  #     becomes /index.md for the homepage and /event/NN/index.md for
  #     event detail pages.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    Header append Link "</sitemap.xml>; rel=\"sitemap\""
    Header append Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
    Header append Link "<index.md>; rel=\"alternate\"; type=\"text/markdown\""
  </FilesMatch>

  # Serve .md files as UTF-8 markdown so agents get the right Content-Type.
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>

</IfModule>
